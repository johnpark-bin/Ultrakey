{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultrakey",
  "version": "0.1.2",
  "identifier": "app.ultrakey.Ultrakey",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "permissions",
        "title": "Ultrakey",
        "width": 520,
        "height": 400,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Ultrakey",
        "width": 825,
        "height": 821,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "frameworks": [
        "Sparkle.framework"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
